# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Read automatically by `python -m pipeline.collect` via pipeline/env.py; an existing
# environment variable always wins over this file.
#
# Register free at https://data.bus-data.dft.gov.uk/account/signup/ then copy your key
# from the account page. Required only by the live collector: the archive replay and the
# website need no key.
BODS_API_KEY=

# Optional: an official timetable download URL for the operators you are collecting.
# Repeatable on the command line with --timetable-url.
BODS_TIMETABLE_URL=
