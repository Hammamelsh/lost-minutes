# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Raw archives and local capture history stay out of source control.
/data/raw/
/data/live-capture/
__pycache__/
*.pyc
*.tsbuildinfo
!.env.example

/.pnpm-store/
/next-env.d.ts

# Windows download metadata (alternate data streams copied in from Explorer).
*:Zone.Identifier

# Local AI-assistant instructions: useful on this machine, not part of the published project.
/CLAUDE.md
/AGENTS.md

# Local Python environment and DuckDB warehouse; rebuildable from raw sources.
/.venv/
/data/warehouse/
/data/published/

# Browser test output: screenshots, traces and reports are regenerated on every run.
/test-results/
/playwright-report/
/blob-report/

# MapLibre's modules, copied from node_modules by scripts/vendor-maplibre.mjs at dev and build time.
/public/vendor/
