# Lost Minutes: the static site from out/ and the published data from public/data, over HTTPS.
#
# LM_DOMAIN and LM_ROOT come from /etc/lost-minutes/caddy.env through the drop-in in
# deploy/systemd/caddy.service.d/. With a real domain whose A record points at the server, Caddy
# obtains and renews the certificate itself (ports 80 and 443 open). For a local check,
# deploy/validate.sh runs this same file over plain HTTP on 127.0.0.1.

{$LM_DOMAIN} {
	encode zstd gzip

	# The private preview of the view from above (docs/PHOTO_3D_PREVIEW.md): the page and the
	# server's offer of a 3D tileset (with the provider's key) behind a password, never cached, never
	# indexed. Locked by default: until the owner sets a password with deploy/set-preview-password.sh,
	# the hash below is of a random password that was never recorded, so nobody can enter. The offer
	# is one file the collector writes under data/ ({$LM_ROOT}/data/private), which no other route
	# serves: /data/* is public/data, and only this handler rewrites to that one file.
	@preview path /preview /preview/*
	handle @preview {
		basic_auth bcrypt "Lost Minutes preview" {
			{$LM_PREVIEW_USER:preview} {$LM_PREVIEW_HASH:$2a$14$0H/8Q8GMbZzHLtbPd4oiceIIY6ns5OduSGNQGGBQSOoBwbmXUvLGG}
		}
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow"
		handle /preview/photo3d.json {
			root * {$LM_ROOT}/data/private
			rewrite * /photo3d.json
			file_server
		}
		handle {
			root * {$LM_ROOT}/out
			file_server
		}
	}

	# Everything under /data is served from where the pipeline publishes, so the collector's
	# rewrites are live at once. out/data is only the copy taken at build time.
	handle /data/* {
		root * {$LM_ROOT}/public
		# Rewritten every 20 s by one writer: a short cache absorbs load without serving
		# anything more than about 10 s behind the collector.
		header /data/live.json Cache-Control "public, max-age=10, stale-while-revalidate=20"
		header /data/operations.json Cache-Control "public, max-age=10, stale-while-revalidate=20"
		# Runtime pointers: a change takes effect within a minute, with no rebuild.
		header /data/config.json Cache-Control "public, max-age=60"
		header /data/replay.json Cache-Control "public, max-age=3600"
		header /data/roads.json Cache-Control "public, max-age=3600"
		# Timetable patterns, stops, road shapes and the evaluation change at most nightly.
		header ?Cache-Control "public, max-age=300"
		file_server
	}

	handle {
		root * {$LM_ROOT}/out
		# Content-hashed file names never change.
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		# MapLibre's modules live under a folder named by version, so a cached copy can never
		# mix two releases.
		header /vendor/* Cache-Control "public, max-age=31536000, immutable"
		# The two typefaces: stable names, so a day with revalidation rather than a year.
		header /fonts/* Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		# The page and the service worker must revalidate, so a deploy is picked up.
		header / Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Location only for this site's own "Locate me"; nothing else is asked for.
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
		-Server
	}

	log
}
