# /etc/lost-minutes/collector.env, read by systemd for the collector and the nightly rebuild.
# Owned by root, group lostminutes, mode 0640 (deploy/install.sh sets this). Never commit a
# filled-in copy, never paste the key into a chat, a log or a ticket.

# Your BODS API key (https://data.bus-data.dft.gov.uk/account/settings/).
BODS_API_KEY=

# The timetable datasets to archive and match against: HTTPS download URLs, comma or space
# separated. All four are needed, one per operator group; each was identified by downloading it
# and matching its SHA-256 against the catalogue actually published (docs/COVERAGE.md).
#   17472  BNML   11.6 MB    14928  BNSM   10.0 MB
#   12769  BNGN    4.4 MB    14241  BNFM    0.6 MB
# Leaving one out does not fail: the build simply publishes a smaller catalogue, and because the
# refusal guard only fires below half the previous size, a missing small group is silent.
BODS_TIMETABLE_URL=https://data.bus-data.dft.gov.uk/timetable/dataset/17472/download/,https://data.bus-data.dft.gov.uk/timetable/dataset/14928/download/,https://data.bus-data.dft.gov.uk/timetable/dataset/12769/download/,https://data.bus-data.dft.gov.uk/timetable/dataset/14241/download/

# Walking directions router written into config.json; "none" switches walking directions off.
# LM_WALKING_ROUTER=
