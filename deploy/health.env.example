# Copy to /etc/lost-minutes/health.env on the server (chmod 600, owned by root). Never commit it.
#
# A dead man's switch: the watchdog pings this URL whenever a fresh publication exists, and
# pings <URL>/fail when it has had to restart the collector. When the pings stop — because the
# collector, the server or the network has stopped — the service that owns the URL emails you
# after its grace period.
#
# Healthchecks.io's free plan gives 20 such checks and email alerts. Nothing is created or paid
# for until the owner says which destination to use; leave this unset and the watchdog simply
# restarts a stalled collector and says so in the journal.
#
# LM_HEALTH_PING_URL=https://hc-ping.com/<uuid>

# Seconds without a publication before the collector is restarted.
LM_MAX_PUBLICATION_AGE=600
