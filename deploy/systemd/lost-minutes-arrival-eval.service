[Unit]
Description=Lost Minutes: score the arrival estimator on last night's snapshot of the warehouse; the collector is not touched
Documentation=file:///srv/lost-minutes/app/docs/ARRIVAL_RELEASE_CRITERIA.md
After=lost-minutes-refresh.service
# No snapshot, nothing to score: the refresh writes it while the collector is already stopped.
ConditionPathExists=/srv/lost-minutes/app/data/evaluation/snapshot.duckdb

[Service]
Type=oneshot
User=lostminutes
Group=lostminutes
WorkingDirectory=/srv/lost-minutes/app
EnvironmentFile=/etc/lost-minutes/collector.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Reads a copy of the warehouse taken by the nightly rebuild, so this can fail, hang or be
# killed without a passenger seeing anything but the ordinary publications: it never stops the
# collector and never opens the live file. The first version stopped the collector for the
# duration; a hand-run copy of that design on 20 September left collection down for 119 s when a
# step before the restart failed. Nothing here reaches a passenger: results go under data/.
# Each attempt records itself for the Operations view (pipeline/jobs.py); "-": never the job's failure.
ExecStartPre=-/srv/lost-minutes/app/.venv/bin/python -m pipeline.jobs start arrival-eval
# The display protocol (docs/ARRIVAL_DISPLAY_PROTOCOL.md), a day at a time: DuckDB reads the new complete days'
# inputs in one process, and they are scored in another that never loads it (scripts/extract-arrival-inputs.py
# says why). A day already scored is not scored again, so the work does not grow with the warehouse. (Until 29
# September 2026 every night re-scored every day held: 684.5M on eight days, heading for the ceiling.)
ExecStart=/srv/lost-minutes/app/.venv/bin/python -m pipeline.jobs step arrival-eval -- /srv/lost-minutes/app/.venv/bin/python scripts/extract-arrival-inputs.py --line 15 --db data/evaluation/snapshot.duckdb --scored data/evaluation/arrival-display-nightly.jsonl --out data/evaluation/arrival-display-inputs.pkl
ExecStart=/srv/lost-minutes/app/.venv/bin/python -m pipeline.jobs step arrival-eval -- /srv/lost-minutes/app/.venv/bin/python scripts/evaluate-arrival-display.py --inputs data/evaluation/arrival-display-inputs.pkl --out data/evaluation/arrival-display-nightly.jsonl
# The schedule anchor on the server's own reports of the last fortnight (not served: the page reads the shipped file).
ExecStart=/srv/lost-minutes/app/.venv/bin/python -m pipeline.jobs step arrival-eval -- /srv/lost-minutes/app/.venv/bin/python scripts/audit-passages.py --line 15 --db data/evaluation/snapshot.duckdb --since-days 14 --out data/evaluation/passages-15-server.json
ExecStart=/srv/lost-minutes/app/.venv/bin/python -m pipeline.jobs step arrival-eval -- /srv/lost-minutes/app/.venv/bin/python scripts/schedule-anchor.py --line 15 --db data/evaluation/snapshot.duckdb --passages data/evaluation/passages-15-server.json --out data/evaluation/schedule-anchor-server.json
# Read the criteria on the confirmation days, once they are all scored; the page reads the verdict. A passing
# scope is shown only once deploy/arrival-release-approval.json names it field for field.
ExecStart=/srv/lost-minutes/app/.venv/bin/python -m pipeline.jobs step arrival-eval -- /srv/lost-minutes/app/.venv/bin/python scripts/arrival-release-check.py --out public/data/arrival-release.json --approval deploy/arrival-release-approval.json
ExecStopPost=-/srv/lost-minutes/app/.venv/bin/python -m pipeline.jobs finish arrival-eval
TimeoutStartSec=20min
Environment=LM_DB_MEMORY_LIMIT=1GB
Environment=LM_DB_THREADS=2
MemoryMax=1500M
# It runs beside the collector and can be run again tomorrow; the collector cannot re-fetch what it
# misses. If memory runs out, this goes first.
OOMScoreAdjust=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/lost-minutes/app/data /srv/lost-minutes/app/public/data
