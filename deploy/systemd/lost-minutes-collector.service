[Unit]
Description=Lost Minutes collector: BODS positions into the warehouse and public/data/live.json
Documentation=file:///srv/lost-minutes/app/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lostminutes
Group=lostminutes
WorkingDirectory=/srv/lost-minutes/app
# The key and the timetable dataset URLs; never in the repository or on a command line.
EnvironmentFile=/etc/lost-minutes/collector.env
Environment=PYTHONDONTWRITEBYTECODE=1
# One run per day: each ends cleanly and is recorded, and systemd starts the next. A crash, an
# out-of-memory kill or a reboot brings collection back the same way, 15 s later.
ExecStart=/srv/lost-minutes/app/.venv/bin/python -m pipeline.collect --minutes 1440
Restart=always
RestartSec=15
# SIGTERM, systemd's own default: the collector records why it stopped and releases its writer lock.
# This was SIGINT until 19 September 2026, which worked here only because systemd does not start a
# service the way a shell starts a background job — a shell hands such a child an ignored SIGINT.
# SIGTERM cannot be inherited away, and the collector now handles all three.
KillSignal=SIGTERM
TimeoutStopSec=30
# It writes only its warehouse, raw captures and published files.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/lost-minutes/app/data /srv/lost-minutes/app/public/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Bound the database's own share, so it cannot reach for 80% of the machine as DuckDB does by
# default. Measured 18 September 2026: this does not shrink the collector much, because most of its
# footprint is Python — the parsed XML, the pattern catalogue and the matcher — but it stops the
# database taking 3.2 GB of a 4 GB server.
Environment=LM_DB_MEMORY_LIMIT=1GB
# Two threads, and two allocator arenas, set explicitly rather than left to the machine. DuckDB
# takes a thread per core and glibc scales its arenas with threads; on the 16-core laptop where this
# was measured that meant 32 threads, a resident set four times larger, and a climb of about 300 MB
# an hour that looked exactly like a leak. With both pinned to 2 the same collector sat flat around
# 370 MB. A CX23 has 2 vCPU and would pick 2 anyway; saying so means the figure does not change if
# it is ever moved to a larger machine. Both were changed together, so which of the two does the
# work is not established — only that the pair removes the growth.
Environment=LM_DB_THREADS=2
Environment=MALLOC_ARENA_MAX=2
# Sized from measurement, not from hope. MemoryMax was 1500M from 13 September, set before anything
# had been measured and checked only by `systemd-analyze verify`, which validates syntax and not
# sizing: the collector's resident set was measured at 1,465 MB rising to 1,626 MB over 27 minutes,
# so that cap would have had the OOM killer take it within the hour, every hour, on a loop.
# MemoryHigh puts the kernel to work reclaiming first; MemoryMax is the ceiling beyond which it is
# killed and systemd starts it again 15 s later. On a 4 GB server this leaves about 1.6 GB for the
# operating system and Caddy. The nightly rebuild does not overlap: lost-minutes-refresh stops this
# unit before it runs.
MemoryHigh=1800M
MemoryMax=2400M

[Install]
WantedBy=multi-user.target
