[Unit]
Description=Lost Minutes: rebuild timetable patterns and the pipeline status, collector paused
Documentation=file:///srv/lost-minutes/app/deploy/README.md
After=network-online.target

[Service]
Type=oneshot
User=lostminutes
Group=lostminutes
WorkingDirectory=/srv/lost-minutes/app
EnvironmentFile=/etc/lost-minutes/collector.env
Environment=PYTHONDONTWRITEBYTECODE=1
# The warehouse has one writer. The collector stops for the rebuild (a gap of a few minutes a
# night, recorded as a run boundary) and is always started again, even if the rebuild fails.
ExecStartPre=+/bin/systemctl stop lost-minutes-collector.service
ExecStart=/srv/lost-minutes/app/.venv/bin/python -m pipeline.patterns build
ExecStart=/srv/lost-minutes/app/.venv/bin/python -m pipeline.run status
ExecStopPost=+/bin/systemctl start lost-minutes-collector.service
TimeoutStartSec=30min
# Measured peak 853 MB on 18 September 2026 (`/usr/bin/time -v`), in 3 min 05 s. This runs with the
# collector stopped, so the two footprints never add up.
Environment=LM_DB_MEMORY_LIMIT=1GB
MemoryMax=1500M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/lost-minutes/app/data /srv/lost-minutes/app/public/data
